{
  "nodeModulesDir": "auto",
  "tasks": {
    "start": "deno serve -A ./main.ts",
    "dev": "deno serve -A --watch ./main.ts"
  },
  "compilerOptions": {
    "lib": [
      "deno.window"
    ],
    "strict": true
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": false,
    "singleQuote": true
  },
  "imports": {
    "@supabase/server": "jsr:@supabase/server@^1",
    "@anthropic-ai/claude-agent-sdk": "npm:@anthropic-ai/claude-agent-sdk@^0.3.251",
    "@std/assert": "jsr:@std/assert@1"
  }
}
